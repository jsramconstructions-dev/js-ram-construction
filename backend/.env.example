# =========================================================
# JS RAM CONSTRUCTION — BACKEND ENVIRONMENT CONFIGURATION
# =========================================================

# Database Connection (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jsram_construction?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Administrator Credentials (seeded on first boot if DB is empty)
ADMIN_EMAIL=admin@jsramconstruction.com
ADMIN_PASSWORD=your_secure_admin_password

# Frontend URL for CORS (comma-separated allowed origins)
# Example: https://jsram.in,https://www.jsram.in,https://js-ram-construction-1.onrender.com
FRONTEND_URL=https://jsram.in,https://www.jsram.in,https://js-ram-construction-1.onrender.com

# Server Port & Environment (Render sets PORT automatically)
PORT=5000
NODE_ENV=production
